{
  "name": "gray-matter-workshop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "pnpm run generate-search && next build",
    "start": "next start",
    "lint": "node scripts/lint-disabled.mjs",
    "lint:force": "eslint src/",
    "type-check": "tsc --noEmit",
    "test": "pnpm run format:check && pnpm run lint && pnpm run type-check && pnpm run build",
    "reference:sync": "node scripts/sync-reference.mjs",
    "reference:refresh": "node scripts/sync-reference.mjs --refresh --prune",
    "spell": "cspell \"src/**/*.{ts,tsx}\" *.md",
    "generate-search": "tsx scripts/generate-search-data.ts",
    "check-embeds": "tsx scripts/check-embeds.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "prepare": "simple-git-hooks",
    "prose": "tsx scripts/lint-prose.ts"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write"
    ],
    "*.{js,jsx,json,css,md}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "onnxruntime-node"
    ]
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.28.0",
    "minisearch": "^7.2.0",
    "next": "^16.2.12",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.409.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shiki": "^4.4.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "three-stdlib": "^2.36.1",
    "uplot": "^1.6.32",
    "valibot": "^1.4.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "cspell": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-next": "16.2.12",
    "lint-staged": "^17.3.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "typescript-6": "npm:typescript@^6.0.3"
  }
}
