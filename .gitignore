# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
bun-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
bun.lockb

# playwright-mcp
.playwright-mcp

# verification screenshots from overnight playground build
.playwright-screenshots

# rendered videos & generated TTS audio (regenerated by `pnpm trailer:audio` + `pnpm render`)
/videos/out/
/videos/.whisper/

# Local render output. These are published as GitHub release assets and read
# from there by src/app/video/page.tsx — they must never be committed. 396 MB of
# stale orphans sat in git-lfs here until they were untracked.
/public/videos/

# Generated TTS audio. The 187 MB WAV cache stays out, but the per-trailer
# timeline JSON is small and worth versioning so a fresh clone can review
# durations and camera timing without a cold Kokoro run. Git cannot re-include a
# file whose parent directory is excluded, so this must exclude the *contents*
# and then negate — not exclude the directory itself.
/videos/public/trailer-audio/*
!/videos/public/trailer-audio/*.timeline.json

# ad-hoc design-review screenshots that land at the repo root
# (e.g. phase4-landing-desktop.png). Drop them into .playwright-mcp/
# or .playwright-screenshots/ if you want to keep them around — they
# don't belong in version control.
phase*-*.png
review_*.png

# local claude-code harness state
.claude/


# Local reference copies of WPILib source, pulled down to check an API against
# ground truth while writing a lesson. Useful to keep on disk, not ours to
# version — the 2027-Template repo is the source of truth, not a stale paste.
/sched.java
/*.java

# Packed npm tarballs from trying a package out locally (pnpm pack / npm pack).
/*.tgz

# Scratch benchmark and sweep scripts. They exist for one measurement and then
# lie about being current; the numbers that mattered get written into the
# comment on the code they justify instead — see videos/remotion.config.ts.
/*.tmp.ts
/*.tmp.mjs
