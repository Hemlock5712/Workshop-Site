{
  "pages": {
    "lesson": "/bline"
  },
  "targets": {
    "header": "#main-content header:has(h1)",
    "lede": "#main-content header:has(h1) .lesson-lede",
    "folderP": "#lesson-article > .lesson-stack > p:has-text(\"The swerve project comes\")",
    "stepWaypoint": "#draw > .lesson-stack > ol:has-text(\"On Home, open Import\") > li:has-text(\"With the Waypoint tool,\")",
    "stepRotation": "#draw > .lesson-stack > ol:has-text(\"On Home, open Import\") > li:has-text(\"With the Rotation tool,\")",
    "eventFig": "#draw figure:has-text(\"An event trigger selected. Lib\")",
    "constraints": "#draw > .lesson-stack > div:has-text(\"Speed limits sit on\")",
    "strayNote": "#draw > .lesson-stack > div:has-text(\"Speed limits sit on\") aside",
    "builderHead": "#builder > div:first-child",
    "builderP": "#builder > .lesson-stack > p:has-text(\"The project also comes\")",
    "builderList": "#builder > .lesson-stack > ul:has-text(\"The three PIDControllers pull\")",
    "gainsLi": "#builder > .lesson-stack > ul:has-text(\"The three PIDControllers pull\") > li:has-text(\"The three PIDControllers pull\")",
    "opmodeHead": "#auto-opmode > div:first-child",
    "opmodeP": "#auto-opmode > .lesson-stack > p:has-text(\"Now let's create AutoOpMode.java\")",
    "pathCode": "#auto-opmode .code-card:has-text(\"Read the path file now\"):not(:has-text(\"package first.robot.opmode\"))",
    "dropP": "#auto-opmode > .lesson-stack > p:has-text(\"One AutoOpMode can hold\")",
    "chooserCode": "#auto-opmode .code-card:has-text(\"Tunables.publish\"):not(:has-text(\"package first.robot.opmode\"))",
    "startP": "#auto-opmode > .lesson-stack > p:has-text(\"Then tell the OpMode\")",
    "startCode": "#auto-opmode .code-card:has-text(\"Tunables.remove\"):not(:has-text(\"package first.robot.opmode\"))",
    "eventP": "#auto-opmode > .lesson-stack > p:has-text(\"Last, give the event\")",
    "eventCode": "#auto-opmode .code-card:has-text(\"the rest of the constructor\")",
    "checkBox": "#check-your-work > .lesson-stack > div:has-text(\"You should see\")"
  },
  "open": [
    {
      "card": "BLine Paths",
      "kicker": "Workshop 6 · Navigation"
    }
  ],
  "lines": {
    "intro": [
      {
        "show": "@header"
      },
      {
        "at": "draw",
        "mark": "@lede",
        "text": "Draw a path on the field"
      }
    ],
    "folder": [
      {
        "show": "@folderP"
      },
      {
        "at": "ships",
        "mark": "@folderP",
        "text": "ships to the robot with every deploy"
      }
    ],
    "points": [
      {
        "show": ["@stepWaypoint", "@stepRotation"]
      },
      {
        "at": "rotation",
        "spot": "@stepRotation"
      }
    ],
    "event": [
      {
        "show": "@eventFig"
      },
      {
        "at": "key",
        "note": "must match the code",
        "on": "@eventFig",
        "side": "top"
      }
    ],
    "strays": [
      {
        "show": "@constraints"
      },
      {
        "at": "delete",
        "spot": "@strayNote"
      }
    ],
    "builder": [
      {
        "show": ["@builderHead", "@builderP"]
      },
      {
        "at": "nothing",
        "mark": "@builderP",
        "text": "You do not type any of it."
      }
    ],
    "gains": [
      {
        "show": "@builderList"
      },
      {
        "at": "Three",
        "spot": "@gainsLi"
      },
      {
        "at": "simulation",
        "mark": "@gainsLi",
        "text": "tuned in simulation only"
      }
    ],
    "opmode": [
      {
        "show": ["@opmodeHead", "@opmodeP"]
      },
      {
        "at": "stays",
        "mark": "@opmodeP",
        "text": "Keep LeaveStartAuto."
      }
    ],
    "path": [
      {
        "code": "@pathCode",
        "lines": [2, 4]
      }
    ],
    "reset": [
      {
        "code": "@pathCode",
        "lines": [3, 4]
      }
    ],
    "chooser": [
      {
        "show": ["@dropP", "@chooserCode"]
      },
      {
        "at": "nothing",
        "code": "@chooserCode",
        "lines": [5, 8]
      }
    ],
    "start": [
      {
        "show": ["@startP", "@startCode"]
      },
      {
        "at": "cancels",
        "mark": "@startP",
        "text": "The framework cancels the routine when the OpMode exits."
      }
    ],
    "trigger": [
      {
        "show": "@eventP"
      },
      {
        "at": "registered",
        "code": "@eventCode",
        "lines": [5, 6]
      }
    ],
    "close": [
      {
        "show": "@checkBox"
      }
    ]
  }
}
