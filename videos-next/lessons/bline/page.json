{
  "pages": {
    "lesson": "/bline"
  },
  "targets": {
    "header": "#main-content header:has(h1)",
    "lede": "#main-content header:has(h1) .lesson-lede",
    "installHead": "#install > div:first-child",
    "installList": "#install > .lesson-stack > ol:has-text(\"In VS Code, open\")",
    "installBuild": "#install > .lesson-stack > ol:has-text(\"In VS Code, open\") > li:has-text(\"Build the project. The first\")",
    "installUrl": "#install .code-card:has-text(\"BLine-Lib 2027.0.0-beta.3, WPILib 2027 alpha-7copy\")",
    "drawHead": "#draw > div:first-child",
    "folderP": "#draw > .lesson-stack > p:has-text(\"The editor works on\")",
    "importFig": "#draw figure:has-text(\"Home, then Import, then Autos\")",
    "stepWaypoint": "#draw > .lesson-stack > ol:has-text(\"On Home, open Import\") > li:has-text(\"With the Waypoint tool,\")",
    "stepRotation": "#draw > .lesson-stack > ol:has-text(\"On Home, open Import\") > li:has-text(\"With the Rotation tool,\")",
    "eventFig": "#draw figure:has-text(\"An event trigger selected. Lib\")",
    "constraints": "#draw > .lesson-stack > div:has-text(\"Speed limits sit on\")",
    "strayNote": "#draw > .lesson-stack > div:has-text(\"Speed limits sit on\") aside",
    "builderCode": "#builder .code-card:has-text(\"DriveMechanism.java: the path request, the builder, and foll\")",
    "gainsLi": "#builder > .lesson-stack > ul:has-text(\"pathRequest is an ApplyRobotVelocity\") > li:has-text(\"The three PIDControllers pull\")",
    "opmodeHead": "#auto-opmode > div:first-child",
    "opmodeP": "#auto-opmode > .lesson-stack > p:has-text(\"Delete LeaveStartAuto.java and create\")",
    "opmodeCode": "#auto-opmode .code-card:has-text(\"src/main/java/frc/robot/opmodes/AutoOpMode.javacopy\")",
    "checkBox": "#check-your-work > .lesson-stack > div:has-text(\"You should see\")",
    "builderList": "#builder > .lesson-stack > ul:has-text(\"pathRequest is an ApplyRobotVelocity\")",
    "argsLi": "#builder > .lesson-stack > ul:has-text(\"pathRequest is an ApplyRobotVelocity\") > li:has-text(\"The first six arguments\")"
  },
  "open": [
    {
      "card": "BLine Paths",
      "kicker": "Workshop 6 · Navigation"
    }
  ],
  "lines": {
    "intro": [
      {
        "show": "@header"
      },
      {
        "at": "draw",
        "mark": "@lede",
        "text": "replaces the Leave Start timer with a drawn path"
      }
    ],
    "install": [
      {
        "show": ["@installHead", "@installList", "@installUrl"]
      },
      {
        "at": "first",
        "spot": "@installBuild"
      }
    ],
    "folder": [
      {
        "show": ["@drawHead", "@folderP"]
      },
      {
        "at": "rides",
        "mark": "@folderP",
        "text": "ships to the robot with every deploy"
      }
    ],
    "points": [
      {
        "show": ["@stepWaypoint", "@stepRotation"]
      },
      {
        "at": "rotation",
        "spot": "@stepRotation"
      }
    ],
    "event": [
      {
        "show": "@eventFig"
      },
      {
        "at": "key",
        "note": "must match the code",
        "on": "@eventFig",
        "side": "top"
      }
    ],
    "strays": [
      {
        "show": "@constraints"
      },
      {
        "at": "delete",
        "spot": "@strayNote"
      }
    ],
    "builder": [
      {
        "code": "@builderCode",
        "lines": [10, 11]
      },
      {
        "at": "arguments",
        "show": "@builderList"
      },
      {
        "at": "where",
        "spot": "@argsLi"
      }
    ],
    "gains": [
      {
        "show": "@builderList"
      },
      {
        "at": "Three",
        "spot": "@gainsLi"
      },
      {
        "at": "simulation",
        "mark": "@gainsLi",
        "text": "tuned in simulation only"
      }
    ],
    "opmode": [
      {
        "show": ["@opmodeHead", "@opmodeP"]
      },
      {
        "at": "drop-down",
        "mark": "@opmodeP",
        "text": "a drop-down on the dashboard picks"
      }
    ],
    "trigger": [
      {
        "code": "@opmodeCode",
        "lines": [19, 23]
      },
      {
        "at": "file",
        "code": "@opmodeCode",
        "lines": [25, 27]
      }
    ],
    "reset": [
      {
        "code": "@opmodeCode",
        "lines": [25, 27]
      }
    ],
    "start": [
      {
        "code": "@opmodeCode",
        "lines": [44, 48]
      }
    ],
    "close": [
      {
        "show": "@checkBox"
      }
    ]
  }
}
