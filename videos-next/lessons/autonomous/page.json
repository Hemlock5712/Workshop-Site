{
  "pages": {
    "lesson": "/autonomous"
  },
  "targets": {
    "header": "#main-content header:has(h1)",
    "crudeP": "#build-the-routine > .lesson-stack > p:has-text(\"Create LeaveStartAuto.java in the\")",
    "code": "#build-the-routine .code-card:has-text(\"every speed is zero\"):not(:has-text(\"package first.robot.opmode\"))",
    "warn": "#check-your-work > .lesson-stack > div:has-text(\"Don'tNobody in front of\")",
    "lifeP": "#build-the-routine > .lesson-stack > p:has-text(\"Last, tell the OpMode\")",
    "lifeCode": "#build-the-routine .code-card:has-text(\"the constructor, unchanged\")",
    "simHead": "#simulation-first > div:first-child",
    "simP": "#simulation-first > .lesson-stack > p:has-text(\"Before you run any\")",
    "simList": "#simulation-first > .lesson-stack > ol:has-text(\"Run WPILib: Simulate Robot\")",
    "simPose": "#simulation-first > .lesson-stack > ol:has-text(\"Run WPILib: Simulate Robot\") > li:has-text(\"Enable, and watch Drivetrain/Pose\")",
    "simBox": "#simulation-first > .lesson-stack > div:has-text(\"CheckYou should seeThe robot drive\")",
    "floorP": "#check-your-work > .lesson-stack > p:has-text(\"Put the robot on\")",
    "seeBox": "#check-your-work > .lesson-stack > div:has-text(\"CheckYou should seeThe robot leaving\")",
    "secondP": "#check-your-work > .lesson-stack > p:has-text(\"A second routine is\")"
  },
  "open": [
    {
      "card": "Autonomous",
      "kicker": "Workshop 6 · Navigation"
    }
  ],
  "lines": {
    "intro": [
      {
        "show": "@header"
      }
    ],
    "crude": [
      {
        "show": "@crudeP"
      },
      {
        "at": "timer",
        "mark": "@crudeP",
        "text": "on a timer"
      }
    ],
    "forward": [
      {
        "code": "@code",
        "lines": [5, 7]
      }
    ],
    "routine": [
      {
        "code": "@code",
        "lines": [13, 17]
      }
    ],
    "cancel": [
      {
        "code": "@code",
        "lines": [16, 18]
      }
    ],
    "life": [
      {
        "show": ["@lifeP", "@lifeCode"]
      },
      {
        "at": "nothing",
        "mark": "@lifeP",
        "text": "There is no end() to write."
      }
    ],
    "sim": [
      {
        "show": ["@simHead", "@simP", "@simList", "@simBox"]
      },
      {
        "at": "pose",
        "spot": "@simPose"
      },
      {
        "at": "stay",
        "spot": "@simBox"
      }
    ],
    "safety": [
      {
        "show": "@warn"
      }
    ],
    "floor": [
      {
        "show": ["@floorP", "@seeBox"]
      },
      {
        "at": "bumper",
        "mark": "@seeBox",
        "text": "in the direction its front bumper points"
      }
    ],
    "close": [
      {
        "show": "@secondP"
      },
      {
        "at": "second",
        "mark": "@secondP",
        "text": "A second routine is a second file."
      }
    ]
  }
}
