{
  "pages": {
    "lesson": "/autonomous"
  },
  "targets": {
    "header": "#main-content header:has(h1)",
    "crudeP": "#build-the-routine > .lesson-stack > p:has-text(\"Create LeaveStartAuto.java in the\")",
    "code": "#build-the-routine .code-card:has-text(\"every speed is zero\"):not(:has-text(\"package frc.robot.opmodes\"))",
    "warn": "#check-your-work > .lesson-stack > div:has-text(\"Don'tNobody in front of\")",
    "lifeCode": "#build-the-routine .code-card:has-text(\"the constructor, unchanged\")",
    "simHead": "#simulation-first > div:first-child",
    "simP": "#simulation-first > .lesson-stack > p:has-text(\"Before you run any\")",
    "simList": "#simulation-first > .lesson-stack > ol:has-text(\"Run WPILib: Simulate Robot\")",
    "simPose": "#simulation-first > .lesson-stack > ol:has-text(\"Run WPILib: Simulate Robot\") > li:has-text(\"Enable, and watch Drivetrain/Pose\")",
    "floorP": "#check-your-work > .lesson-stack > p:has-text(\"Put the robot on\")",
    "seeBox": "#check-your-work > .lesson-stack > div:has-text(\"CheckYou should seeThe robot\")"
  },
  "open": [
    {
      "card": "Autonomous",
      "kicker": "Workshop 6 · Navigation"
    }
  ],
  "lines": {
    "intro": [
      {
        "show": "@header"
      }
    ],
    "crude": [
      {
        "show": "@crudeP"
      },
      {
        "at": "timer",
        "mark": "@crudeP",
        "text": "on a timer"
      }
    ],
    "forward": [
      {
        "code": "@code",
        "lines": [5, 7]
      }
    ],
    "routine": [
      {
        "code": "@code",
        "lines": [13, 17]
      }
    ],
    "cancel": [
      {
        "code": "@code",
        "lines": [16, 18]
      }
    ],
    "life": [
      {
        "code": "@lifeCode",
        "lines": [3, 11]
      }
    ],
    "pose": [
      {
        "show": ["@simHead", "@simP", "@simList"]
      },
      {
        "at": "pose",
        "spot": "@simPose"
      }
    ],
    "safety": [
      {
        "show": "@warn"
      }
    ],
    "passes": [
      {
        "show": ["@floorP", "@seeBox"]
      },
      {
        "at": "floor",
        "mark": "@floorP",
        "text": "Put the robot on the floor",
        "until": "end"
      }
    ],
    "disable": [
      {
        "at": "stop",
        "mark": "@seeBox",
        "text": "stopping and staying stopped",
        "until": "end"
      }
    ]
  }
}
