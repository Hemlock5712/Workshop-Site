{
  "pages": { "lesson": "/project-setup" },
  "targets": {
    "header": "#main-content header:has(h1)",
    "lede": "#main-content header:has(h1) .lesson-lede",
    "fig1": "#make-the-project figure:has-text(\"No red icon here means\")",
    "fig3": "#make-the-project figure:has-text(\"Template gives you a skeleton.\")",
    "fig4": "#make-the-project figure:has-text(\"Timed Robot and Command v2\")",
    "thirdP": "#make-the-project > .lesson-stack > p:has-text(\"The third page is\")",
    "fields": "#make-the-project > .lesson-stack > ol:has-text(\"Base Folder. Click Select\")",
    "fig5": "#make-the-project figure:has-text(\"Enable Desktop Support is circled.\")",
    "warn": "#make-the-project > .lesson-stack > div:has-text(\"Watch outNot in OneDriveOneDrive,\")",
    "swapHead": "#vendor-libraries > div:first-child",
    "swapP": "#vendor-libraries > .lesson-stack > p:has-text(\"The project you just\")",
    "steps": "#vendor-libraries > .lesson-stack > ol:has-text(\"Under Installed Dependencies, delete\")",
    "stepPhoenix": "#vendor-libraries > .lesson-stack > ol:has-text(\"Under Installed Dependencies, delete\") > li:has-text(\"In the same list,\")",
    "fig8": "#vendor-libraries figure",
    "buildP": "#vendor-libraries > .lesson-stack > p:has-text(\"Changing a dependency starts\")",
    "resolveP": "#vendor-libraries > .lesson-stack > p:has-text(\"A build that stops\")",
    "checkP": "#check-your-work > .lesson-stack > p:has-text(\"Wait for the build\")",
    "checkBox": "#check-your-work > .lesson-stack > div:has-text(\"CheckYou should seeBUILD SUCCESSFUL\")"
  },
  "open": [
    { "card": "Project Setup", "kicker": "Workshop 3 · Robot Programming" }
  ],
  "lines": {
    "intro": [
      { "show": "@header" },
      {
        "at": "project",
        "mark": "@lede",
        "text": "You generate a robot project"
      }
    ],
    "icon": [{ "show": "@fig1" }],
    "template": [{ "show": "@fig3" }],
    "opmode": [
      { "show": "@fig4" },
      { "at": "one", "note": "OpMode Robot", "on": "@fig4", "side": "top" }
    ],
    "third": [{ "show": ["@thirdP", "@fields"] }],
    "desktop": [{ "show": "@fig5" }],
    "sync": [
      { "show": "@warn" },
      {
        "at": "Documents",
        "mark": "@warn",
        "text": "are often synced without anyone saying so"
      }
    ],
    "swap": [
      { "show": ["@swapHead", "@swapP"] },
      {
        "at": "share",
        "mark": "@swapP",
        "text": "cannot sit in the same project"
      }
    ],
    "panel": [{ "show": "@steps" }, { "at": "Watch", "spot": "@stepPhoenix" }],
    "build": [{ "show": ["@fig8", "@buildP"] }],
    "resolve": [{ "show": "@resolveP" }],
    "close": [{ "show": ["@checkP", "@checkBox"] }]
  }
}
