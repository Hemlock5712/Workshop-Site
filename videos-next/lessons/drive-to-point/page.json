{
  "pages": { "lesson": "/drive-to-point" },
  "targets": {
    "header": "#main-content header:has(h1)",
    "poseHead": "#the-pose-you-are-driving-to > div:first-child",
    "poseP": "#the-pose-you-are-driving-to > .lesson-stack > p:has-text(\"The target is a\")",
    "oneHead": "#one-waypoint > div:first-child",
    "oneP": "#one-waypoint > .lesson-stack > p:has-text(\"A drawn path is\")",
    "driveCode": "#one-waypoint .code-card:has-text(\"src/main/java/frc/robot/subsystems/DriveMechanism.javacopy\")",
    "sameP": "#one-waypoint > .lesson-stack > p:has-text(\"Everything the pathBuilder was\")",
    "flipP": "#one-waypoint > .lesson-stack > p:has-text(\"withShouldFlip(() -> false) overrides\")",
    "teleopCode": "#bind-it .code-card:has-text(\"src/main/java/frc/robot/opmodes/TeleopOpMode.javacopy\")",
    "holdP": "#bind-it > .lesson-stack > p:has-text(\"whileTrue cancels the command\")",
    "steps": "#check-your-work > .lesson-stack > ol:has-text(\"Enable Teleop in full\")",
    "step3": "#check-your-work > .lesson-stack > ol:has-text(\"Enable Teleop in full\") > li:has-text(\"Hold B until the\")",
    "seeBox": "#check-your-work > .lesson-stack > div:has-text(\"CheckYou should seeOn A,\")"
  },
  "open": [{ "card": "Drive to Point", "kicker": "Workshop 6 · Navigation" }],
  "lines": {
    "intro": [
      { "show": "@header" },
      {
        "at": "single",
        "mark": "#main-content header:has(h1) .lesson-lede",
        "text": "a BLine path with one waypoint"
      }
    ],
    "pose": [
      { "show": ["@poseHead", "@poseP"] },
      { "at": "wheels", "mark": "@poseP", "text": "Odometry alone drifts" }
    ],
    "list": [
      { "show": ["@oneHead", "@oneP"] },
      { "at": "one", "mark": "@oneP", "text": "is the whole path" }
    ],
    "start": [{ "code": "@driveCode", "lines": [14, 16] }],
    "same": [
      { "show": "@sameP" },
      { "at": "controllers", "mark": "@sameP", "text": "comes along" }
    ],
    "flip": [{ "code": "@driveCode", "lines": [17, 18] }],
    "fixed": [
      { "show": "@flipP" },
      { "at": "flipping", "mark": "@flipP", "text": "the far end" }
    ],
    "bind": [{ "code": "@teleopCode", "lines": [10, 12] }],
    "release": [
      { "show": "@holdP" },
      {
        "at": "canceled",
        "mark": "@holdP",
        "text": "sends the zero on the way out",
        "until": "end"
      }
    ],
    "arrive": [
      {
        "at": "sticks",
        "mark": "@holdP",
        "text": "even if the button is still down"
      }
    ],
    "check": [
      { "show": ["@steps", "@seeBox"] },
      { "at": "third", "spot": "@step3" }
    ],
    "close": [{ "show": "@seeBox" }]
  }
}
