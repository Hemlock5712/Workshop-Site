{
  "pages": {
    "lesson": "/drive-to-point"
  },
  "targets": {
    "header": "#main-content header:has(h1)",
    "poseHead": "#the-pose-you-are-driving-to > div:first-child",
    "poseP": "#the-pose-you-are-driving-to > .lesson-stack > p:has-text(\"As you learned in\")",
    "oneHead": "#one-waypoint > div:first-child",
    "oneP": "#one-waypoint > .lesson-stack > p:has-text(\"Add driveToPoint to\")",
    "driveCode": "#one-waypoint .code-card:has-text(\"src/main/java/frc/robot/subsystems/DriveMechanism.javacopy\")",
    "sameP": "#one-waypoint > .lesson-stack > p:has-text(\"Everything the pathBuilder was\")",
    "teleopCode": "#bind-it .code-card:has-text(\"src/main/java/frc/robot/opmodes/TeleopOpMode.javacopy\")",
    "holdP": "#bind-it > .lesson-stack > p:has-text(\"whileTrue cancels the command\")",
    "steps": "#check-your-work > .lesson-stack > ol:has-text(\"Enable Teleop in full\")",
    "step3": "#check-your-work > .lesson-stack > ol:has-text(\"Enable Teleop in full\") > li:has-text(\"Hold B until the\")",
    "seeBox": "#check-your-work > .lesson-stack > div:has-text(\"CheckYou should seeOn A,\")",
    "allianceP": "#one-waypoint > .lesson-stack > p:has-text(\"The alliance check comes\")"
  },
  "open": [
    {
      "card": "Drive to Point",
      "kicker": "Workshop 6 · Navigation"
    }
  ],
  "lines": {
    "intro": [
      {
        "show": "@header"
      },
      {
        "at": "single",
        "mark": "#main-content header:has(h1) .lesson-lede",
        "text": "with BLine, on the fly"
      }
    ],
    "pose": [
      {
        "show": ["@poseHead", "@poseP"]
      },
      {
        "at": "wheels",
        "mark": "@poseP",
        "text": "odometry alone drifts"
      }
    ],
    "list": [
      {
        "show": ["@oneHead", "@oneP"]
      },
      {
        "at": "one",
        "mark": "@oneP",
        "text": "is the whole path"
      }
    ],
    "start": [
      {
        "code": "@driveCode",
        "lines": [4, 6]
      }
    ],
    "same": [
      {
        "show": "@sameP"
      },
      {
        "at": "controllers",
        "mark": "@sameP",
        "text": "comes along"
      }
    ],
    "flip": [
      {
        "show": "@allianceP"
      },
      {
        "at": "turned",
        "mark": "@allianceP",
        "text": "On red, BLine turns it around the field center"
      }
    ],
    "bind": [
      {
        "code": "@teleopCode",
        "lines": [10, 12]
      }
    ],
    "release": [
      {
        "show": "@holdP"
      },
      {
        "at": "canceled",
        "mark": "@holdP",
        "text": "cancels the command when the button is released",
        "until": "end"
      }
    ],
    "arrive": [
      {
        "at": "sticks",
        "mark": "@holdP",
        "text": "even if the button is still down"
      }
    ],
    "check": [
      {
        "show": ["@steps", "@seeBox"]
      },
      {
        "at": "third",
        "spot": "@step3"
      }
    ],
    "close": [
      {
        "show": "@seeBox"
      }
    ]
  }
}
