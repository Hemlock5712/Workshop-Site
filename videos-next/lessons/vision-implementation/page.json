{
  "pages": {
    "lesson": "/vision-implementation"
  },
  "targets": {
    "header": "#main-content header:has(h1)",
    "robotP": "#start-it-in-robot > .lesson-stack > p:has-text(\"Add one field to\")",
    "robot": "#start-it-in-robot .code-card:has-text(\"src/main/java/first/robot/Robot.javacopy\")",
    "nameP": "#start-it-in-robot > .lesson-stack > p:has-text(\"The string has to\")",
    "steps": "#check-your-work > .lesson-stack > ol:has-text(\"Park about two meters\")",
    "checkBox": "#check-your-work > .lesson-stack > div:has-text(\"CheckYou should seeNear the\")",
    "classHead": "#the-vision-class > div:first-child",
    "libP": "#the-vision-class > .lesson-stack > p:has-text(\"The swerve project comes\")",
    "solversP": "#the-vision-class > .lesson-stack > p:has-text(\"The camera can solve\")",
    "updateCode": "#the-vision-class .code-card:has-text(\"private void update()\"):not(:has-text(\"package first.robot.mechanisms\"))",
    "pickCode": "#the-vision-class .code-card:has-text(\"With one tag, ask again as MegaTag2\"):not(:has-text(\"package first.robot.mechanisms\"))",
    "gateCode": "#the-vision-class .code-card:has-text(\"inside addFrame, under the if\")",
    "trustP": "#the-vision-class > .lesson-stack > p:has-text(\"Each sighting goes in\")",
    "growP": "#the-vision-class > .lesson-stack > p:has-text(\"A small number makes\")",
    "stdCode": "#the-vision-class .code-card:has-text(\"headingStdDev = 9_999_999\"):not(:has-text(\"package first.robot.mechanisms\"))",
    "stampCode": "#the-vision-class .code-card:has-text(\"drivetrain.addVisionMeasurement\"):not(:has-text(\"package first.robot.mechanisms\"))"
  },
  "open": [
    {
      "card": "Vision",
      "kicker": "Workshop 7 · Vision"
    }
  ],
  "lines": {
    "intro": [
      {
        "show": "@header"
      }
    ],
    "install": [
      {
        "show": ["@classHead", "@libP"]
      }
    ],
    "solvers": [
      {
        "show": "@solversP"
      },
      {
        "at": "first",
        "mark": "@solversP",
        "text": "needs two or more tags to do it well"
      }
    ],
    "borrow": [
      {
        "at": "second",
        "mark": "@solversP",
        "text": "takes the heading you shared as given"
      }
    ],
    "loop": [
      {
        "code": "@updateCode",
        "lines": [12, 22]
      },
      {
        "at": "queue",
        "code": "@updateCode",
        "lines": [16, 21]
      }
    ],
    "pick": [
      {
        "code": "@pickCode",
        "lines": [2, 7]
      }
    ],
    "gates": [
      {
        "code": "@gateCode",
        "lines": [3, 5]
      }
    ],
    "stamp": [
      {
        "code": "@stampCode",
        "lines": [1, 5]
      }
    ],
    "trust": [
      {
        "show": ["@trustP", "@growP"]
      },
      {
        "at": "distance",
        "mark": "@growP",
        "text": "The number grows with distance"
      }
    ],
    "echo": [
      {
        "code": "@stdCode",
        "lines": [8, 12]
      }
    ],
    "robot": [
      {
        "show": ["@robotP", "@robot", "@nameP"]
      },
      {
        "at": "OpMode",
        "mark": "@robotP",
        "text": "thrown away on every mode switch"
      },
      {
        "at": "name",
        "code": "@robot",
        "lines": [8, 9]
      }
    ],
    "close": [
      {
        "show": ["@steps", "@checkBox"]
      }
    ]
  }
}
