{
  "pages": {
    "lesson": "/vision-implementation"
  },
  "targets": {
    "header": "#main-content header:has(h1)",
    "url": "#install-the-library .code-card:has-text(\"Vendor dependency URLcopy\")",
    "mega": "#megatag1-and-megatag2",
    "megaP": "#megatag1-and-megatag2 > .lesson-stack > div:has-text(\"The camera solves the\")",
    "mt1": "#megatag1-and-megatag2 p:has-text(\"MegaTag1 solves position\")",
    "mt2": "#megatag1-and-megatag2 p:has-text(\"MegaTag2 takes your heading\")",
    "vision": "#the-vision-class .code-card:has-text(\"src/main/java/frc/robot/subsystems/Vision.javacopy\")",
    "trustHead": "#the-trust-weighting > div:first-child",
    "trustP1": "#the-trust-weighting > .lesson-stack > p:has-text(\"Every sighting goes into\")",
    "trustP2": "#the-trust-weighting > .lesson-stack > p:has-text(\"Distance hurts gently and\")",
    "trustP3": "#the-trust-weighting > .lesson-stack > p:has-text(\"MegaTag2 solved its pose\")",
    "robotP": "#start-it-in-robot > .lesson-stack > p:has-text(\"Add one field to\")",
    "robot": "#start-it-in-robot .code-card:has-text(\"src/main/java/frc/robot/Robot.javacopy\")",
    "nameP": "#start-it-in-robot > .lesson-stack > p:has-text(\"The string has to\")",
    "steps": "#check-your-work > .lesson-stack > ol:has-text(\"Park about two meters\")",
    "stepUncover": "#check-your-work > .lesson-stack > ol:has-text(\"Park about two meters\") > li:has-text(\"Uncover the camera. The\")",
    "checkBox": "#check-your-work > .lesson-stack > div:has-text(\"CheckYou should seeCorrections stop\")",
    "installP": "#install-the-library > .lesson-stack > div:has-text(\"LimelightLib is a vendor\")"
  },
  "open": [
    {
      "card": "Vision",
      "kicker": "Workshop 7 · Vision"
    }
  ],
  "lines": {
    "intro": [
      {
        "show": "@header"
      }
    ],
    "install": [
      {
        "show": ["@installP", "@url"]
      },
      {
        "at": "alpha",
        "spot": "@url"
      }
    ],
    "solvers": [
      {
        "show": "@mega"
      },
      {
        "at": "first",
        "spot": "@mt1"
      }
    ],
    "borrow": [
      {
        "spot": "@mt2"
      },
      {
        "at": "wrong",
        "mark": "@mt2",
        "text": "wrong and looks fine"
      }
    ],
    "loop": [
      {
        "code": "@vision",
        "lines": [46, 56]
      },
      {
        "at": "queue",
        "code": "@vision",
        "lines": [50, 55]
      }
    ],
    "pick": [
      {
        "code": "@vision",
        "lines": [58, 62]
      }
    ],
    "gates": [
      {
        "code": "@vision",
        "lines": [64, 67]
      }
    ],
    "stamp": [
      {
        "code": "@vision",
        "lines": [77, 81]
      }
    ],
    "trust": [
      {
        "show": ["@trustHead", "@trustP1", "@trustP2"]
      },
      {
        "at": "quarter",
        "mark": "@trustP2",
        "text": "a second tag divides it by four"
      }
    ],
    "echo": [
      {
        "show": "@trustP3"
      },
      {
        "at": "ignored",
        "mark": "@trustP3",
        "text": "the robot agreeing with itself"
      }
    ],
    "robot": [
      {
        "show": ["@robotP", "@robot", "@nameP"]
      },
      {
        "at": "OpMode",
        "mark": "@robotP",
        "text": "thrown away on every mode switch"
      },
      {
        "at": "name",
        "code": "@robot",
        "lines": [8, 9]
      }
    ],
    "close": [
      {
        "show": ["@steps", "@checkBox"]
      },
      {
        "at": "uncover",
        "spot": "@stepUncover"
      }
    ]
  }
}
