{
  "pages": {
    "lesson": "/align-to-tag"
  },
  "targets": {
    "header": "#main-content header:has(h1)",
    "lede": "#main-content header:has(h1) .lesson-lede",
    "frameHead": "#the-tags-frame > div:first-child",
    "frameP": "#the-tags-frame > .lesson-stack > p:has-text(\"A pose measured from\")",
    "frameCode": "#the-tags-frame .code-card:has-text(\"src/main/java/frc/robot/subsystems/Vision.javacopy\")",
    "danger": "#the-tags-frame > .lesson-stack > div:has-text(\"DANGER · SIGNSTest this\")",
    "mapHead": "#remember-the-tag > div:first-child",
    "mapP": "#remember-the-tag > .lesson-stack > p:has-text(\"The camera will lose\")",
    "mapCode": "#remember-the-tag .code-card:has-text(\"src/main/java/frc/robot/subsystems/Vision.javacopy\")",
    "driveHead": "#drive-in-the-tags-frame > div:first-child",
    "driveP": "#drive-in-the-tags-frame > .lesson-stack > p:has-text(\"Add alignToTag to DriveMechanism,\")",
    "recordHead": "#record-your-spot > div:first-child",
    "recordP": "#record-your-spot > .lesson-stack > p:has-text(\"Do not measure the\")",
    "recordSteps": "#record-your-spot > .lesson-stack > ol:has-text(\"Disable the robot and\")",
    "eventP": "#record-your-spot > .lesson-stack > p:has-text(\"Record it again on\")",
    "checkSteps": "#check-your-work > .lesson-stack > ol:has-text(\"Disabled, push the robot\")",
    "check3": "#check-your-work > .lesson-stack > ol:has-text(\"Disabled, push the robot\") > li:has-text(\"Back the robot up,\")",
    "seeBox": "#check-your-work > .lesson-stack > div:has-text(\"CheckYou should seeAbout (1.5,\")",
    "lostP": "#drive-in-the-tags-frame > .lesson-stack > p:has-text(\"If the camera loses\")"
  },
  "open": [
    {
      "card": "Align to Tag",
      "kicker": "Workshop 7 · Vision"
    }
  ],
  "lines": {
    "intro": [
      {
        "show": "@header"
      },
      {
        "at": "never",
        "mark": "@lede",
        "text": "a spot measured from one AprilTag"
      }
    ],
    "frame": [
      {
        "show": ["@frameHead", "@frameP"]
      },
      {
        "at": "forward",
        "mark": "@frameP",
        "text": "X points straight out of its face"
      }
    ],
    "convert": [
      {
        "code": "@frameCode",
        "lines": [4, 10]
      }
    ],
    "danger": [
      {
        "show": "@danger"
      }
    ],
    "map": [
      {
        "show": ["@mapHead", "@mapP"]
      },
      {
        "at": "wheels",
        "mark": "@mapP",
        "text": "From then on the wheels fill in"
      }
    ],
    "gates": [
      {
        "code": "@mapCode",
        "lines": [12, 15]
      }
    ],
    "remember": [
      {
        "code": "@mapCode",
        "lines": [22, 33]
      },
      {
        "at": "logs",
        "code": "@mapCode",
        "lines": [31, 31]
      }
    ],
    "drive": [
      {
        "show": ["@driveHead", "@driveP"]
      },
      {
        "at": "pose",
        "mark": "@driveP",
        "text": "BLine drives in the tag's frame"
      }
    ],
    "empty": [
      {
        "show": "@lostP"
      },
      {
        "at": "quits",
        "mark": "@lostP",
        "text": "The path finishes at once and nothing moves"
      }
    ],
    "record": [
      {
        "show": ["@recordHead", "@recordP", "@recordSteps"]
      },
      {
        "at": "measure",
        "mark": "@recordP",
        "text": "mounting error cancels out"
      }
    ],
    "event": [
      {
        "show": "@eventP"
      },
      {
        "at": "hand",
        "mark": "@eventP",
        "text": "no two fields match to the centimeter"
      }
    ],
    "close": [
      {
        "show": ["@checkSteps", "@seeBox"]
      },
      {
        "at": "third",
        "spot": "@check3"
      }
    ]
  }
}
